@model FocusFlow.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard — FocusFlow";

    double score = Model.ScorePercentage;
    string color = Model.BadgeColor;
    string level = Model.FeedbackLevel;
    double ringFill = Math.Round(score / 100.0 * 439.8, 1);

    string ringStroke = color switch
    {
        "success" => "#22c55e",
        "warning" => "#f59e0b",
        _ => "#ef4444"
    };

    string levelLabel = level switch
    {
        "excellent" => "Excellent",
        "good" => "Good",
        _ => "Needs Work"
    };

    string accentCss = color switch
    {
        "success" => "#22c55e",
        "warning" => "#f59e0b",
        _ => "#ef4444"
    };
}

<style>
    :root {
        --ff-bg: #0d0f14;
        --ff-surface: #13161e;
        --ff-surface2: #1a1d27;
        --ff-border: rgba(255,255,255,0.07);
        --ff-text: #e2e8f0;
        --ff-muted: #64748b;
        --ff-green: #22c55e;
        --ff-amber: #f59e0b;
        --ff-red: #ef4444;
        --ff-blue: #3b82f6;
        --ff-purple: #a78bfa;
        --ff-accent: @accentCss;
        --ff-radius: 20px;
        --ff-font: 'DM Sans', 'Segoe UI', sans-serif;
    }

    body {
        background: var(--ff-bg);
        color: var(--ff-text);
        font-family: var(--ff-font);
        margin: 0;
    }

    .ff-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 24px; 
        padding: 24px;
        max-width: 1400px; 
        margin: 0 auto;
    }

    .ff-card {
        background: var(--ff-surface);
        border: 1px solid var(--ff-border);
        border-radius: var(--ff-radius);
        padding: 32px;
        display: flex;
        flex-direction: column;
        transition: all .3s ease;
    }

        .ff-card:hover {
            border-color: rgba(255,255,255,0.15);
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.2);
        }

    .col-left {
        grid-column: span 4;
    }

    .col-right {
        grid-column: span 8;
    }

    .col-6 {
        grid-column: span 6;
    }

    @@media (max-width: 1100px) {
        .col-left, .col-right, .col-6 {
            grid-column: span 12;
        }
    }

    .ff-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ff-muted);
        margin-bottom: 20px;
    }

    .ff-big-stat {
        font-size: 72px; 
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
        margin: 10px 0;
    }

    .ff-feedback {
        border-left: 4px solid var(--ff-accent);
        background: rgba(255,255,255,0.03);
        padding: 20px 24px;
        border-radius: 0 12px 12px 0;
        font-size: 16px;
        line-height: 1.6;
    }

    .score-ring {
        transition: stroke-dasharray 1s ease-in-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ff-card {
        animation: fadeInUp 0.5s ease both;
    }
</style>

<div style="padding:40px 24px 20px; max-width:1400px; margin:0 auto; display:flex; justify-content:space-between; align-items:flex-end;">
    <div>
        <h1 style="font-size:38px; font-weight:800; letter-spacing:-0.03em; margin:0;">Dashboard</h1>
        <p style="color:var(--ff-muted); margin-top:8px; font-size:16px;">Welcome back, let's crush your goals today.</p>
    </div>
    <div style="display:flex; gap:12px;">
        <a asp-controller="StudySession" asp-action="Log" style="background:var(--ff-accent); color:#000; font-weight:700; padding:14px 28px; border-radius:12px; text-decoration:none;">+ Log Session</a>
        <a asp-controller="Subject" asp-action="Create" style="background:var(--ff-surface2); color:white; padding:14px 28px; border-radius:12px; text-decoration:none; border:1px solid var(--ff-border);">Add Subject</a>
    </div>
</div>

<div class="ff-grid">

    <div class="ff-card col-left" style="align-items:center; text-align:center;">
        <div class="ff-label">Weekly Focus Score</div>

        <svg width="220" height="220" viewBox="0 0 160 160">
            <circle cx="80" cy="80" r="70" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="12" />
            <circle class="score-ring" cx="80" cy="80" r="70" fill="none"
                    stroke="@ringStroke" stroke-width="12" stroke-linecap="round"
                    stroke-dasharray="@ringFill 439.8" transform="rotate(-90 80 80)"
                    style="filter: drop-shadow(0 0 12px @ringStroke);" />
            <text x="80" y="85" text-anchor="middle" font-size="32" font-weight="800" fill="white">@score%</text>
        </svg>

        <div style="margin-top:24px; background:rgba(255,255,255,0.05); padding:8px 20px; border-radius:99px; color:var(--ff-accent); font-weight:700; letter-spacing:1px;">
            @levelLabel.ToUpper()
        </div>

        <div style="width:100%; margin-top:32px;">
            <div style="display:flex; justify-content:space-between; font-size:14px; color:var(--ff-muted); margin-bottom:10px;">
                <span>Progress</span>
                <span>@Model.WeeklyHours / @Model.TargetHours h</span>
            </div>
            <div style="height:8px; background:rgba(255,255,255,0.05); border-radius:10px; overflow:hidden;">
                <div style="width:@score%; height:100%; background:var(--ff-accent); border-radius:10px;"></div>
            </div>
        </div>
    </div>

    <div class="ff-card col-right">
        <div class="ff-label">AI Analysis & Feedback</div>
        <div class="ff-feedback" style="margin-bottom:32px;">
            <strong style="color:var(--ff-accent); display:block; margin-bottom:8px; font-size:18px;">@levelLabel</strong>
            @Model.FeedbackMessage
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px;">
            <div style="background:var(--ff-surface2); padding:24px; border-radius:16px;">
                <div class="ff-label" style="margin-bottom:8px;">Total Study Time</div>
                <div class="ff-big-stat" style="color:var(--ff-blue)">@Model.TotalHours<span style="font-size:24px; color:var(--ff-muted)">h</span></div>
                <p style="color:var(--ff-muted); font-size:14px;">Lifetime dedication</p>
            </div>
            <div style="background:var(--ff-surface2); padding:24px; border-radius:16px;">
                <div class="ff-label" style="margin-bottom:8px;">Strongest Subject</div>
                <div style="font-size:32px; font-weight:700; margin:15px 0; color:var(--ff-green)">@Model.StrongestSubject</div>
                <div style="color:var(--ff-muted); font-size:14px;">@Model.StrongestHours hours logged</div>
            </div>
        </div>
    </div>

    <div class="ff-card col-6">
        <div class="ff-label">Hours Breakdown</div>
        <div style="display:flex; flex-direction:column; gap:24px; margin-top:10px;">
            @foreach (var kv in Model.HoursPerSubject.OrderByDescending(x => x.Value))
            {
                <div>
                    <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-weight:600;">
                        <span>@kv.Key</span>
                        <span style="color:var(--ff-muted)">@kv.Value h</span>
                    </div>
                    <div style="height:10px; background:rgba(255,255,255,0.05); border-radius:20px;">
                        <div style="width:@(Math.Min(kv.Value / (Model.TotalHours + 0.1) * 100, 100))%; height:100%; background:var(--ff-blue); border-radius:20px;"></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="ff-card col-6">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
            <div class="ff-label" style="margin-bottom:0;">Recent Activity</div>
            <a href="#" style="color:var(--ff-accent); text-decoration:none; font-size:14px; font-weight:600;">View All</a>
        </div>
        <table style="width:100%; border-collapse: collapse;">
            @foreach (var s in Model.RecentSessions.Take(5))
            {
                <tr style="border-bottom: 1px solid var(--ff-border);">
                    <td style="padding:16px 0; color:var(--ff-muted); font-size:14px;">@s.Date.ToString("MMM dd")</td>
                    <td style="padding:16px 0; font-weight:600;">@s.SubjectName</td>
                    <td style="padding:16px 0; text-align:right; font-weight:700; color:var(--ff-accent);">+@s.Hours h</td>
                </tr>
            }
        </table>
    </div>

</div>