<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FocusFlow</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        :root {
            --ff-navy: #0f172a;
            --ff-surface: #1e293b;
            --ff-card: #ffffff;
            --ff-border: #e2e8f0;
            --ff-text: #0f172a;
            --ff-muted: #64748b;
            --ff-good: #16a34a;
            --ff-avg: #b45309;
            --ff-weak: #dc2626;
            --ff-accent: #2563eb;
            --ff-font: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
            --ff-radius: 12px;
            --nav-h: 64px;
        }

        html, body {
            font-family: var(--ff-font);
            background: #f1f5f9;
            color: var(--ff-text);
            min-height: 100vh;
        }

        .ff-nav {
            height: var(--nav-h);
            background: var(--ff-navy);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .ff-nav .container-fluid {
                height: 100%;
                display: flex;
                align-items: center;
                padding: 0 28px;
            }

        .ff-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-right: 32px;
        }

        .ff-brand-icon {
            width: 34px;
            height: 34px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
        }

        .ff-brand-text {
            font-weight: 800;
            color: #fff;
        }

        .ff-nav-links {
            display: flex;
            gap: 6px;
            flex: 1;
        }

        .ff-nav-link {
            padding: 8px 14px;
            border-radius: 8px;
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: background .15s, color .15s;
        }

            .ff-nav-link:hover {
                background: rgba(255,255,255,0.08);
                color: #fff;
            }

            .ff-nav-link.active {
                background: rgba(96,165,250,0.15);
                color: #60a5fa;
            }

        .ff-nav-badge {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ff-score-pill {
            font-size: 12px;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 99px;
        }

        .ff-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            border: 2px solid rgba(255,255,255,0.2);
            transition: border-color .2s, transform .15s;
        }

            .ff-avatar:hover {
                border-color: rgba(255,255,255,0.5);
                transform: scale(1.05);
            }

        .ff-page {
            padding: 32px;
        }

        .ff-footer {
            text-align: center;
            font-size: 12px;
            color: var(--ff-muted);
            padding: 24px;
            margin-top: 48px;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <nav class="ff-nav">
        <div class="container-fluid">

            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="ff-brand">
                <div class="ff-brand-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <span class="ff-brand-text">Focus<span style="color:#60a5fa;">Flow</span></span>
            </a>

            <!-- Links -->
            <div class="ff-nav-links">
                <a asp-controller="Home" asp-action="Index"
                   class="ff-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    Home
                </a>
                <a asp-controller="Subject" asp-action="Index"
                   class="ff-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subject" ? "active" : "")">
                    Subjects
                </a>
                <a asp-controller="StudySession" asp-action="Index"
                   class="ff-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StudySession" ? "active" : "")">
                    Sessions
                </a>
                <a asp-controller="Dashboard" asp-action="Index"
                   class="ff-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    Dashboard
                </a>
            </div>

            <!-- Right Section -->
            <div class="ff-nav-badge">

                <!-- Score -->
                @if (ViewBag.NavScore != null)
                {
                    string navLevel = ViewBag.NavLevel ?? "weak";
                    string pillCss = navLevel == "excellent" ? "bg-success text-white"
                    : navLevel == "good" ? "bg-warning text-dark"
                    : "bg-danger text-white";
                    <span class="ff-score-pill @pillCss">
                        @ViewBag.NavScore%
                    </span>
                }

                <!-- Auth -->
                @if (User.Identity!.IsAuthenticated)
                {
                    string userEmail = User.Identity.Name ?? "?";
                    string initials = userEmail.Length > 0
                    ? userEmail[0].ToString().ToUpper() : "?";

                    <div class="dropdown">
                        <button class="btn p-0 border-0 bg-transparent"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <div class="ff-avatar">@initials</div>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end mt-2 shadow"
                            style="min-width:220px;border-radius:12px;
                                       border:1px solid #e2e8f0;padding:8px;">

                            <!-- User Info -->
                            <li style="padding:10px 14px 8px;">
                                <div style="font-size:11px;color:#64748b;
                                                font-weight:600;text-transform:uppercase;
                                                letter-spacing:.05em;">
                                    Signed in as
                                </div>
                                <div style="font-size:13px;font-weight:700;
                                                color:#0f172a;white-space:nowrap;
                                                overflow:hidden;text-overflow:ellipsis;
                                                max-width:190px;">
                                    @userEmail
                                </div>
                            </li>

                            <li><hr class="dropdown-divider my-1"></li>

                            <!-- Dashboard -->
                            <li>
                                <a asp-controller="Dashboard" asp-action="Index"
                                   class="dropdown-item rounded-2 d-flex align-items-center gap-2"
                                   style="font-size:13px;font-weight:500;">
                                    <i class="bi bi-speedometer2 text-primary"></i>
                                    Dashboard
                                </a>
                            </li>

                            <!-- Subjects -->
                            <li>
                                <a asp-controller="Subject" asp-action="Index"
                                   class="dropdown-item rounded-2 d-flex align-items-center gap-2"
                                   style="font-size:13px;font-weight:500;">
                                    <i class="bi bi-journal-bookmark text-primary"></i>
                                    My Subjects
                                </a>
                            </li>

                            <li><hr class="dropdown-divider my-1"></li>

                            <!-- Logout -->
                            <li>
                                <form asp-controller="Account" asp-action="Logout"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="dropdown-item rounded-2
                                                       d-flex align-items-center gap-2 text-danger"
                                            style="font-size:13px;font-weight:600;">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       class="btn btn-sm btn-outline-light rounded-pill px-3">
                        Login
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                       class="btn btn-sm btn-primary rounded-pill px-3">
                        Register
                    </a>
                }

            </div>

        </div>
    </nav>

    <main class="ff-page">
        @RenderBody()
    </main>

    <footer class="ff-footer">
        FocusFlow &copy; @DateTime.Now.Year
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>