@model FocusFlow.Models.Subject

@{
    ViewData["Title"] = "Edit Subject";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Header -->
                    <div class="mb-4">
                        <a asp-action="Index"
                           class="text-muted text-decoration-none small
                                  d-inline-flex align-items-center gap-1 mb-3">
                            <i class="bi bi-arrow-left"></i> Back to subjects
                        </a>
                        <h3 class="fw-bold mb-1">Edit Subject</h3>
                        <p class="text-muted small mb-0">
                            Updating: <strong>@Model.Name</strong>
                        </p>
                    </div>

                    <!-- IMPORTANT: asp-action="Edit" posts to Edit POST action  -->
                    <!-- asp-route-id sends the Id back in the URL               -->
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <!-- ✅ CRITICAL: Hidden Id field so model binding works  -->
                        <!-- Without this the posted Subject.Id would be 0        -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Subject Name -->
                        <div class="mb-4">
                            <label asp-for="Name"
                                   class="form-label fw-semibold small
                                          text-uppercase text-muted">
                                Subject Name
                            </label>
                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3
                                          @(ViewData.ModelState["Name"]?.Errors.Count > 0
                                                                                 ? "is-invalid" : "")"
                                   placeholder="e.g. Mathematics" />
                            <span asp-validation-for="Name"
                                  class="invalid-feedback fw-semibold"></span>
                        </div>

                        <!-- Target Hours -->
                        <div class="mb-4">
                            <label asp-for="TargetHours"
                                   class="form-label fw-semibold small
                                          text-uppercase text-muted">
                                Target Hours
                            </label>
                            <div class="input-group input-group-lg">
                                <input asp-for="TargetHours"
                                       type="number" min="1" max="10000"
                                       class="form-control rounded-start-3
                                              @(ViewData.ModelState["TargetHours"]?.Errors.Count > 0
                                                                                         ? "is-invalid" : "")" />
                                <span class="input-group-text bg-light
                                             text-muted rounded-end-3 border-start-0">
                                    hours
                                </span>
                                <span asp-validation-for="TargetHours"
                                      class="invalid-feedback fw-semibold"></span>
                            </div>
                        </div>

                        <hr class="text-muted opacity-25 mb-4" />

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-success btn-lg flex-grow-1 rounded-3">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                                Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}