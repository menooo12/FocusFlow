@model List<FocusFlow.Models.SubjectProgressViewModel>

@{
    ViewData["Title"] = "Subjects Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">My Subjects</h2>
        <p class="text-muted small mb-0">Track your logged study time and progress targets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Subject
    </a>
</div>

@if (!Model.Any())
{
    <div class="card text-center p-5 text-muted border-0 shadow-sm rounded-4">
        <i class="bi bi-journal-x fs-1 mb-3"></i>
        <p class="mb-3">No subjects found in your list.</p>
        <div class="d-flex justify-content-center">
            <a asp-action="Create" class="btn btn-outline-primary rounded-pill px-4">Start by adding one</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4 py-3">Subject Name</th>
                    <th class="py-3">Target (h)</th>
                    <th class="py-3">Logged (h)</th>
                    <th class="py-3">Progress Status</th>
                    <th class="pe-4 py-3 text-end">Manage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vm in Model)
                {
                    // منطق الألوان بناءً على النسبة
                    var progressColor = vm.ProgressPct >= 80 ? "bg-success" : vm.ProgressPct >= 50 ? "bg-warning" : "bg-danger";
                    var textColor = vm.ProgressPct >= 80 ? "text-success" : vm.ProgressPct >= 50 ? "text-warning" : "text-danger";

                    <tr>
                        <td class="ps-4 fw-bold text-dark">@vm.Subject.Name</td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                @vm.Subject.TargetHours h
                            </span>
                        </td>
                        <td>
                            <span class="fw-bold @textColor">@vm.LoggedHours h</span>
                        </td>
                        <td style="min-width: 180px;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height:7px; border-radius:10px; background-color: #eee;">
                                    <div class="progress-bar @progressColor"
                                         role="progressbar"
                                         style="width: @vm.ProgressPct%; border-radius:10px;"
                                         aria-valuenow="@vm.ProgressPct"
                                         aria-valuemin="0"
                                         aria-valuemax="100"></div>
                                </div>
                                <span class="small fw-semibold @textColor">@vm.ProgressPct%</span>
                            </div>
                        </td>
                        <td class="pe-4 text-end">
                            <div class="btn-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <a asp-action="Edit" asp-route-id="@vm.Subject.Id" class="btn btn-sm btn-white border-end">
                                    <i class="bi bi-pencil text-muted"></i>
                                </a>
                                @* زر الحذف المباشر *@
                                <a asp-action="Delete" asp-route-id="@vm.Subject.Id"
                                   class="btn btn-sm btn-white"
                                   onclick="return confirm('Delete this subject and all its related history? This cannot be undone.');">
                                    <i class="bi bi-trash text-danger"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}