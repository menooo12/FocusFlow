@model FocusFlow.Models.Subject

@{
    ViewData["Title"] = "Add Subject";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <!-- Card wrapper -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Header -->
                    <div class="mb-4">
                        <a asp-action="Index"
                           class="text-muted text-decoration-none small d-inline-flex
                                  align-items-center gap-1 mb-3">
                            <i class="bi bi-arrow-left"></i> Back to subjects
                        </a>
                        <h3 class="fw-semibold mb-1">Add a Subject</h3>
                        <p class="text-muted small mb-0">
                            Set a study goal to track your progress
                        </p>
                    </div>

                    <!-- Form -->
                    <form asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Subject Name -->
                        <div class="mb-4">
                            <label asp-for="Name"
                                   class="form-label fw-semibold small text-uppercase
                                          text-muted letter-spacing-1">
                                Subject Name
                            </label>
                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3
                                          @(ViewData.ModelState["Name"]?.Errors.Count > 0
                                                                                 ? "is-invalid" : "")"
                                   placeholder="e.g. Mathematics, Physics…" />
                            <span asp-validation-for="Name"
                                  class="invalid-feedback fw-semibold"></span>
                        </div>

                        <!-- Target Hours -->
                        <div class="mb-4">
                            <label asp-for="TargetHours"
                                   class="form-label fw-semibold small text-uppercase
                                          text-muted">
                                Target Hours
                            </label>
                            <div class="input-group input-group-lg">
                                <input asp-for="TargetHours"
                                       type="number"
                                       min="1"
                                       max="10000"
                                       class="form-control rounded-start-3
                                              @(ViewData.ModelState["TargetHours"]?.Errors.Count > 0
                                                                                         ? "is-invalid" : "")"
                                       placeholder="40" />
                                <span class="input-group-text bg-light text-muted
                                             rounded-end-3 border-start-0">
                                    hours
                                </span>
                                <span asp-validation-for="TargetHours"
                                      class="invalid-feedback fw-semibold"></span>
                            </div>
                            <div class="form-text text-muted mt-1">
                                How many total hours do you want to study this subject?
                            </div>
                        </div>

                        <!-- Quick-pick buttons -->
                        <div class="mb-4">
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var hrs in new[] { 10, 20, 30, 40, 60, 100 })
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary rounded-pill"
                                            onclick="document.getElementById('TargetHours')
                                                            .value = @hrs">
                                        @hrs h
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Divider -->
                        <hr class="text-muted opacity-25 mb-4" />

                        <!-- Actions -->
                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary btn-lg flex-grow-1 rounded-3">
                                <i class="bi bi-check-lg me-1"></i> Save Subject
                            </button>
                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>

            <!-- Validation summary (only visible when errors exist) -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger rounded-3 mt-3 d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                    <div>
                        <div class="fw-semibold mb-1">Please fix the following:</div>
                        <asp-validation-summary asp-validation-summary="ModelOnly"
                                                class="mb-0 ps-3" />
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



